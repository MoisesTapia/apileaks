# ============================================================
# APILeak — Environment Variables Example
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your values
#   docker compose --profile mcp up -d
# ============================================================

# ── MCP Server — Required for HTTP transport ─────────────────────────────
#
# Bearer token that all MCP HTTP clients must include:
#   Authorization: Bearer <token>
#
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
APILEAKS_MCP_AUTH_TOKEN=change-me-before-use

# ── MCP Server — Options ─────────────────────────────────────────────────

# Port exposed on the host (default: 8080)
MCP_HOST_PORT=8080

# Max tool invocations per client per minute (default: 60)
MCP_RATE_LIMIT=60

# Set to "true" to allow destructive tools.
# Each destructive invocation still requires a ConfirmationToken.
MCP_ALLOW_DESTRUCTIVE=false

# ── TLS (optional — leave empty to use a reverse proxy) ──────────────────
#
# If provided, the MCP server uses native TLS (no proxy needed).
# See docs/mcp-docker.md for nginx / Caddy / Traefik examples.
#
MCP_TLS_CERT=
MCP_TLS_KEY=

# ── AI Provider (optional) ────────────────────────────────────────────────
#
# Enables --ai-triage and --ai-dedup features.
# Requires: pip install 'apileaks[mcp,ai]'
#
# Provider: anthropic | openai | bedrock | (empty = disabled)
AI_PROVIDER=
AI_MODEL=

# Anthropic API key (required if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# OpenAI API key (required if AI_PROVIDER=openai)
OPENAI_API_KEY=

# ── Amazon Bedrock (AI_PROVIDER=bedrock) ──────────────────────────────────
#
# Uses the standard AWS credentials chain.
# Leave empty to use IAM role / AWS profile / ~/.aws/credentials.
#
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
# AWS_PROFILE=my-profile

# ── Scan Defaults ────────────────────────────────────────────────────────

APILEAK_LOG_LEVEL=INFO
APILEAK_RATE_LIMIT=10
APILEAK_VERIFY_SSL=true
APILEAK_TIMEOUT=10
